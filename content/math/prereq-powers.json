    {
      "id": "math.problem.pow.1",
      "skillId": "math.pow.square-root",
      "level": "medium",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Un quadrato ha l'area di 169 cm². Quanto misura il lato?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "Lato",
            "units": [
              "cm",
              "cm²",
              "cm³"
            ]
          }
        ],
        "figure": {
          "shape": "square",
          "side": "?"
        }
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 13,
            "knownErrors": [
              {
                "value": 84.5,
                "tag": "root_as_half",
                "message": "La radice non è la metà: cerca il numero che moltiplicato per se stesso dà 169."
              },
              {
                "value": 42.25,
                "tag": "square_from_perimeter",
                "message": "169 è l'area, non il perimetro: il lato si trova con la radice."
              }
            ],
            "unit": "cm"
          }
        }
      },
      "solution": [
        "Area = lato × lato, quindi lato $= \\sqrt{169}$",
        "$13 \\times 13 = 169$",
        "Risposta: il lato misura 13 cm."
      ]
    },
    {
      "id": "math.problem.pow.2",
