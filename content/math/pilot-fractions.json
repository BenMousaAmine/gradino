      "recipe": [
        "Da frazione a decimale: dividi il numeratore per il denominatore.",
        "Da decimale a frazione: scrivi il numero senza virgola al numeratore. Al denominatore metti 10 se c'è una cifra dopo la virgola, 100 se ce ne sono due, 1000 se tre.",
        "Poi semplifica."
      ],
      "example": {
        "prompt": "Scrivi 0,4 come frazione",
        "steps": ["Una cifra dopo la virgola: $0{,}4 = \\frac{4}{10}$", "Semplifico per 2: $\\frac{2}{5}$"],
        "answer": "$\\frac{2}{5}$"
