    {
      "skillId": "math.frac.inverse-problems",
      "title": "Problemi con la frazione inversa",
      "understand": {
        "paragraphs": [
          "A volte conosci una parte e devi trovare il tutto: i $\\frac{3}{4}$ di un numero sono 36. Qual è il numero?",
