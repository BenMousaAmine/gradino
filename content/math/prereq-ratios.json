    {
      "id": "math.problem.ratio.1",
      "skillId": "math.ratio.percent",
      "level": "base",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "In una classe di 25 alunni, il 40% sono femmine. Quante sono le femmine?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "femmine"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 10,
            "knownErrors": [
              {
                "value": 15,
                "tag": "complement_missing",
                "message": "15 sono i maschi: la domanda chiede le femmine."
              },
              {
                "value": 40,
                "tag": "percent_inverse",
                "message": "40 è la percentuale, non il numero di alunne."
              }
            ]
          }
        }
      },
      "solution": [
        "L'1% di 25: $25 : 100 = 0{,}25$",
        "Il 40%: $0{,}25 \\times 40 = 10$",
        "Risposta: le femmine sono 10."
      ]
    },
    {
      "id": "math.problem.ratio.2",
      "skillId": "math.ratio.percent-problems",
      "level": "advanced",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Un telefono costava 300 €. Prima è stato scontato del 20%, poi il nuovo prezzo è aumentato del 10%. Quanto costa adesso?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "€"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 264,
            "knownErrors": [
              {
                "value": 270,
                "tag": "percent_successive",
                "message": "Le percentuali non si sommano: il 10% si calcola sul prezzo dopo lo sconto."
              },
              {
                "value": 240,
                "tag": "stops_early",
                "message": "240 € è il prezzo dopo lo sconto: manca l'aumento."
              }
            ]
          }
        }
      },
      "solution": [
        "Dopo lo sconto: $300 - 60 = 240$ €",
        "Aumento del 10% di 240: $240 : 100 \\times 10 = 24$ €",
        "Prezzo finale: $240 + 24 = 264$ €"
      ]
    },
    {
      "id": "math.problem.ratio.3",
      "skillId": "math.prop.direct",
      "level": "medium",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Per fare una torta per 4 persone servono 200 g di farina. Quanta farina serve per una torta per 10 persone?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "g"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 500,
            "knownErrors": [
              {
                "value": 80,
                "tag": "direct_as_inverse",
                "message": "Più persone, più farina: è proporzionalità diretta."
              },
              {
                "value": 206,
                "tag": "proportion_additive",
                "message": "Non si aggiunge la differenza: trova la farina per una persona."
              }
            ]
          }
        }
      },
      "solution": [
        "Farina per una persona: $200 : 4 = 50$ g",
        "Per 10 persone: $50 \\times 10 = 500$ g"
      ]
    },
    {
