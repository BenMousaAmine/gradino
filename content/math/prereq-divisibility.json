  "items": [
    {
      "id": "math.problem.div.1",
      "skillId": "math.div.gcd",
      "level": "medium",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Un fioraio ha 48 rose e 36 tulipani. Vuole preparare mazzi tutti uguali, usando tutti i fiori, con il numero più grande possibile di mazzi. Quanti mazzi prepara?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "mazzi"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 12,
            "knownErrors": [
              {
                "value": 144,
                "tag": "gcd_lcm_confusion",
                "message": "Qui serve il MCD: vuoi dividere i fiori in gruppi uguali."
              },
              {
                "value": 6,
                "tag": "gcd_incomplete",
                "message": "6 funziona, ma si possono fare più mazzi."
              }
            ]
          }
        }
      },
      "solution": [
        "Servono gruppi uguali senza avanzi: è il MCD",
        "$48 = 2^4 \\times 3$, $36 = 2^2 \\times 3^2$",
        "MCD $= 2^2 \\times 3 = 12$",
        "Risposta: prepara 12 mazzi."
      ]
    },
    {
      "id": "math.problem.div.2",
      "skillId": "math.div.lcm",
      "level": "medium",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Anna va in piscina ogni 4 giorni, Paolo ogni 6 giorni. Oggi ci sono andati insieme. Tra quanti giorni si incontreranno di nuovo in piscina?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "giorni"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 12,
            "knownErrors": [
              {
                "value": 24,
                "tag": "lcm_product",
                "message": "24 funziona, ma si incontrano prima."
              },
              {
                "value": 2,
                "tag": "gcd_lcm_confusion",
                "message": "Qui serve il mcm, non il MCD."
              }
            ]
          }
        }
      },
      "solution": [
        "Cerco il primo giorno multiplo di 4 e di 6: è il mcm",
        "$4 = 2^2$, $6 = 2 \\times 3$",
        "mcm $= 2^2 \\times 3 = 12$",
        "Risposta: tra 12 giorni."
      ]
    }
