  "items": [
    {
      "id": "math.problem.meas.1",
      "skillId": "math.meas.volume-capacity",
      "level": "medium",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Una bottiglia contiene 1,5 L. Quanti bicchieri da 250 mL si riempiono con 3 bottiglie?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "bicchieri"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 18,
            "knownErrors": [
              {
                "value": 6,
                "tag": "stops_early",
                "message": "6 bicchieri sono una sola bottiglia: le bottiglie sono 3."
              },
              {
                "value": 0.018,
                "tag": "unit_conversion",
                "message": "Prima porta tutto in mL: 1 L = 1000 mL."
              }
            ]
          }
        }
      },
      "solution": [
        "Acqua in tutto: $1{,}5 \\times 3 = 4{,}5$ L = 4500 mL",
        "Bicchieri: $4500 : 250 = 18$"
      ]
    },
