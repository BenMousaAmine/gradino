  "items": [
    {
      "id": "math.problem.geo.1",
      "skillId": "math.geo.rectangle-square",
      "level": "medium",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Un campo rettangolare è lungo 60 m e largo 40 m. Si vuole recintarlo con 3 giri di filo. Quanti metri di filo servono?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "Filo",
            "units": [
              "m",
              "m²",
              "m³"
            ]
          }
        ],
        "figure": {
          "shape": "rectangle",
          "base": "60 m",
          "height": "40 m"
        }
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 600,
            "knownErrors": [
              {
                "value": 200,
                "tag": "stops_early",
                "message": "200 m è un solo giro: i giri sono 3."
              },
              {
                "value": 2400,
                "tag": "perimeter_area_confusion",
                "message": "Il filo segue il contorno: serve il perimetro, non l'area."
              }
            ],
            "unit": "m"
          }
        }
      },
      "solution": [
        "Un giro è il perimetro: $2 \\times (60 + 40) = 200$ m",
        "Tre giri: $200 \\times 3 = 600$ m"
      ]
    },
    {
      "id": "math.problem.geo.2",
      "skillId": "math.geo.rectangle-square",
      "level": "advanced",
      "kind": "problem",
      "content": {
        "type": "input",
        "prompt": "Un pavimento rettangolare di 5 m per 4 m viene coperto con piastrelle quadrate di 50 cm di lato. Quante piastrelle servono?",
        "fields": [
          {
            "kind": "number",
            "id": "answer",
            "label": "",
            "suffix": "piastrelle"
          }
        ]
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
            "value": 80,
            "knownErrors": [
              {
                "value": 40,
                "tag": "area_units_factor",
                "message": "Una piastrella non ha area 0,5 m²: è $0{,}5 \\times 0{,}5 = 0{,}25$ m²."
              },
              {
                "value": 0.08,
                "tag": "unit_conversion",
                "message": "Prima porta tutto alla stessa unità di misura."
              }
            ]
          }
        }
      },
      "solution": [
        "Area del pavimento: $5 \\times 4 = 20$ m²",
        "Una piastrella: $0{,}5 \\times 0{,}5 = 0{,}25$ m²",
        "Piastrelle: $20 : 0{,}25 = 80$"
      ]
    },
