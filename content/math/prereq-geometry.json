            "units": [
              "m",
              "m²",
              "m³"
            ]
          }
        ],
        "figure": {
          "shape": "right-triangle",
          "legA": "?",
          "legB": "3 m",
          "hypotenuse": "5 m"
        }
      },
      "key": {
        "type": "input",
        "fields": {
          "answer": {
            "kind": "number",
