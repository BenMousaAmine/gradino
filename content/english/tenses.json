                  ],
                  "tag": "eng_tense_signal",
                  "message": "every day → abitudine → present simple: goes."
                }
              ]
            }
          },
          {
            "label": "Look! They ___ (play) football.",
            "key": {
              "kind": "text",
              "accept": [
