                  "tag": "eng_tense_signal",
                  "message": "Look! → adesso → present continuous: are playing."
                }
              ]
            }
          },
          {
            "label": "We ___ (watch) a film yesterday.",
            "key": {
              "kind": "text",
              "accept": [
                "watched"
              ],
