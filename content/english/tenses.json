{
  "lessons": [
    {
      "skillId": "english.tenses.signal-words",
      "title": "Che tempo uso? Le parole-spia",
      "understand": {
        "paragraphs": [
          "Prima di coniugare un verbo, chiediti: quando succede? La risposta te la danno le parole-spia.",
          "every day, usually, always, on Mondays → abitudine → present simple (she plays).",
          "now, at the moment, Look! → sta succedendo adesso → present continuous (she is playing).",
          "yesterday, last week, two days ago → è già successo → past simple (she played)."
        ]
      },
      "recipe": [
        "Cerca la parola-spia nella frase.",
        "Scegli il tempo: abitudine, adesso o passato.",
        "Applica la formula: -s con he/she/it · am/is/are + -ing · -ed o seconda forma.",
        "Nelle negazioni: don't/doesn't, am/is/are not, didn't."
      ],
      "example": {
        "prompt": "Look! My brother ___ (ride) a bike.",
        "steps": [
          "Parola-spia: Look! → sta succedendo adesso.",
          "Present continuous: my brother = he → is + verbo in -ing.",
          "ride finisce in -e: la e cade → riding."
        ],
        "answer": "Look! My brother is riding a bike."
      },
      "complete": {
        "prompt": "Completa con il tempo giusto.",
        "given": [],
        "blanks": [
          {
